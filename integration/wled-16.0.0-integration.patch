-  if (SEGMENT.call % (((255 - SEGMENT.speed) >> 6) + 1) == 0) { // how often the force is applied depends on speed setting
-    int32_t xgravity;
-    int32_t increment = (SEGMENT.speed >> 6) + 1;
-    SEGENV.aux0 += increment;
-    if (SEGMENT.check3) // random, use perlin noise
-      xgravity = ((int16_t)perlin8(SEGENV.aux0) - 128);
-    else // sinusoidal
-      xgravity = (int16_t)cos8_t(SEGENV.aux0) - 128;//((int32_t)(SEGMENT.custom3 << 2) * cos8(SEGENV.aux0)
-    // scale the force
-    xgravity = (xgravity * ((SEGMENT.custom3+1) << 2)) / 128; // xgravity: -127 to +127
-    PartSys->applyForce(xgravity);
+  // sensor-driven force: if the MPU9250 compass usermod is present, pull the
+  // particles toward the low side with real gravity; otherwise use the
+  // original virtual (sine/perlin) force
+  um_data_t *um_tilt = nullptr;
+  if (UsermodManager::getUMData(&um_tilt, USERMOD_ID_MPU9250_COMPASS) && um_tilt && um_tilt->u_size >= 1) {
+    float gx = *(float*)um_tilt->u_data[0]; // axis-selected tilt, -1..1
+    PartSys->applyForce((int32_t)(gx * 127.0f));
+  } else {
+    if (SEGMENT.call % (((255 - SEGMENT.speed) >> 6) + 1) == 0) { // how often the force is applied depends on speed setting
+      int32_t xgravity;
+      int32_t increment = (SEGMENT.speed >> 6) + 1;
+      SEGENV.aux0 += increment;
+      if (SEGMENT.check3) // random, use perlin noise
+        xgravity = ((int16_t)perlin8(SEGENV.aux0) - 128);
+      else // sinusoidal
+        xgravity = (int16_t)cos8_t(SEGENV.aux0) - 128;//((int32_t)(SEGMENT.custom3 << 2) * cos8(SEGENV.aux0)
+      // scale the force
+      xgravity = (xgravity * ((SEGMENT.custom3+1) << 2)) / 128; // xgravity: -127 to +127
+      PartSys->applyForce(xgravity);
+    }
   }
 
   uint32_t randomindex = hw_random16(PartSys->usedParticles);
